{
  "telegram": {
    "allowed_user_id": 123456789
  },
  "agent": {
    "max_iterations": 5
  },
  "mcp": {
    "servers": {
      "dokploy": {
        "command": "npx",
        "args": [
          "-y",
          "dokploy-mcp"
        ],
        "env": {
          "DOKPLOY_URL": "${DOKPLOY_URL}",
          "DOKPLOY_API_KEY": "${DOKPLOY_API_KEY}"
        }
      }
    }
  },
  "scheduler": {
    "enabled": true
  }
}